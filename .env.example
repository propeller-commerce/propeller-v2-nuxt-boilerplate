# Server-only (never sent to client). Mirrors propeller-next + propeller-vue.
BOILERPLATE_GRAPHQL_ENDPOINT=https://api.staging.helice.cloud/v2/graphql
BOILERPLATE_API_KEY=
BOILERPLATE_ORDER_EDITOR_API_KEY=
BOILERPLATE_PORTAL_MODE=open
BOILERPLATE_DEFAULT_LANGUAGE=NL
# Comma-separated list of every language the shop ships. The default language
# above stays unprefixed; the others are served under /<code>.
BOILERPLATE_LOCALES=nl,en
BOILERPLATE_CURRENCY=€
REVALIDATE_SECRET=
BASE_CATEGORY_ID=1324
CHANNEL_ID=621

# Exposed to client via runtimeConfig.public
NUXT_PUBLIC_GRAPHQL_ENDPOINT=/api/graphql
NUXT_PUBLIC_SITE_URL=
NUXT_PUBLIC_PORTAL_MODE=open
NUXT_PUBLIC_CURRENCY=€
NUXT_PUBLIC_CURRENCY_CODE=EUR
NUXT_PUBLIC_URL_PATTERN=page/id/slug
NUXT_PUBLIC_MENU_DEPTH=3

# ── Machines / spare parts (client-read via runtimeConfig.public) ────────────
# External system the machine ids belong to. The id list comes from the
# contact's company MY_INSTALLATIONS track attribute at runtime (already in
# configuration.companyTrackAttributes). Leave unset to disable the machines
# root. Tree language usually EN while parts stay in the storefront language.
NUXT_PUBLIC_MACHINE_SOURCE=
NUXT_PUBLIC_MACHINE_LANGUAGE=EN

# ── Payments (PSP: Mollie OR MultiSafepay) ───────────────────────────────────
# Pick ONE provider by setting BOTH PAYMENT_PROVIDER (server) and
# NUXT_PUBLIC_PAYMENT_PROVIDER (client) to the SAME value: `mollie` or
# `multisafepay`. Leave them empty to keep the default "place order → straight to
# thank-you" (on-account) behaviour. Only the matching key block below is read.
PAYMENT_PROVIDER=
# Comma-separated payment-method codes that settle on account (no PSP).
ON_ACCOUNT_PAYMENTS=REKENING,ON_ACCOUNT

# — Mollie —
MOLLIE_TEST_KEY=
MOLLIE_LIVE_KEY=
MOLLIE_TEST_MODE=true
# MOLLIE_WEBHOOK_URL=

# — MultiSafepay —
# MSP_TEST_MODE=true → testapi.multisafepay.com + MSP_TEST_KEY; false →
# api.multisafepay.com + MSP_LIVE_KEY.
MSP_TEST_KEY=
MSP_LIVE_KEY=
MSP_TEST_MODE=true
# Optional account metadata (present for parity with next/vue; not read by app).
MSP_WEBSITE_ID=
MSP_SECURITY_CODE=
# Optional MultiSafepay locale (default en_US when empty).
# MSP_LOCALE=en_US

# The PSP can't reach localhost. In dev, start a tunnel (cloudflared / ngrok) to
# the dev server (port 5000). The shopper redirect uses NUXT_PUBLIC_SITE_URL; the
# webhook falls back to it too, or set MOLLIE_WEBHOOK_URL / MSP_WEBHOOK_URL to the
# tunnel's /api/<provider>/webhook explicitly. Re-set per dev session.
# MSP_WEBHOOK_URL=

# Client-visible toggle (mirror the server PAYMENT_PROVIDER above):
NUXT_PUBLIC_PAYMENT_PROVIDER=
NUXT_PUBLIC_ON_ACCOUNT_PAYMENTS=REKENING,ON_ACCOUNT

# ── Behaviour tracking ───────────────────────────────────────────
# Optional. With nothing configured the shop runs normally, /api/track answers
# 202 and /tracker says so instead of showing empty charts.
#
# Nothing is created automatically — not at install, not at first boot: DDL at
# boot races across instances and needs privileges the app account usually does
# not have. Run `npm run tracking:init` once the variables below point at a
# database (add `-- --dry-run` to see what it would do, `-- --print-sql` to get
# a file a DBA can run by hand).
#
# SERVER-ONLY. These are read via useRuntimeConfig(event) in the Nitro routes
# and must never move under `public` — that would ship the credentials.
#
# THREE WAYS TO CONNECT — pick one.
#
# 1. A single URL. Wins over everything below when set, and is how a hosting
#    platform normally injects a database.
# TRACKING_DB_URL=mysql://user:password@db.internal:3306/propeller_analytics
#
# 2. A unix socket, for a database on the same Linux host. Beats host/port when
#    set, and is the only way in for an account that uses auth_socket.
# TRACKING_DB_SOCKET=/var/run/mysqld/mysqld.sock
# TRACKING_DB_NAME=propeller_analytics
#
# 3. Host and port. TRACKING_DB_PORT defaults to 3306; Laragon's second MySQL 8
#    instance runs on 3307, which is why the dev value below is not the default.
# TRACKING_ENABLED=true
# TRACKING_DB_HOST=127.0.0.1
# TRACKING_DB_PORT=3307
# TRACKING_DB_USER=root
# TRACKING_DB_PASSWORD=
# TRACKING_DB_NAME=propeller_analytics
# TRACKING_DB_POOL=4
#
# TLS. Every managed MySQL (RDS, Aiven, PlanetScale, DigitalOcean) refuses
# plaintext, so this is required off-host. `true` verifies against the system CA
# store; `skip-verify` encrypts without authenticating the server (a tunnel, not
# security); any other value names a built-in mysql2 profile, e.g. "Amazon RDS".
# TRACKING_DB_SSL=true
# IANA zone used to bucket the daily rollups. Days are bucketed in Node, not via
# MySQL CONVERT_TZ, whose timezone tables are frequently unloaded and which then
# returns NULL rather than erroring — silently dropping rollup rows.
TRACKING_TIMEZONE=Europe/Amsterdam
TRACKING_RETENTION_DAYS=180

# Client-visible switches. Strings compared to 'true', never real booleans:
# Nuxt's NUXT_* override only coerces when the default's type matches, so a
# boolean default changes behaviour between `nuxt dev` and `node .output/server`.
NUXT_PUBLIC_TRACKING_ENABLED=false

# ── Google Analytics 4 / Tag Manager ───────────────────────────────────────
# A second subscriber on the same event bus: the storefront emits its own
# vocabulary and app/lib/tracking/ga4.ts projects it onto Google's. Off by
# default — with NUXT_PUBLIC_USE_GA4=false nothing loads and no dataLayer exists.
#
# NUXT_PUBLIC_GA4_KEY is required when USE_GA4 is true; with no key nothing
# loads. NUXT_PUBLIC_GTM_KEY is optional, and it CHANGES THE TRANSPORT: with a
# container we push {event, ecommerce} objects to dataLayer, without one we call
# gtag('event'). The two are not interchangeable — the wrong one fails silently.
NUXT_PUBLIC_USE_GA4=false
NUXT_PUBLIC_GA4_KEY=
NUXT_PUBLIC_GTM_KEY=
